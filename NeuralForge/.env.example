# NeuralForge Environment Variables Template

# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/neuralforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=neuralforge

# Redis configuration
REDIS_URL=redis://redis:6379/0

# ChromaDB configuration
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Security (JWT)
# Use `openssl rand -hex 32` to generate a secret key
SECRET_KEY=your-super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys for providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local LLM default configuration
OLLAMA_BASE_URL=http://localhost:11434

# Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
